{
  "name": "dsh-ai-radar",
  "version": "0.2.0",
  "type": "module",
  "description": "Sidebar digest for any industry: posts from X (and Hacker News for tech), an LLM editorial pass, and the recurring questions in the replies. The industry, keywords and sources are editable in the panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ai-radar",
    "hacker-news",
    "industry-news"
  ]
}
